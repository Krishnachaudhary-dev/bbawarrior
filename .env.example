# Server side environment for the class board. Copy to .env for local runs and
# set the real values in Vercel (Project Settings > Environment Variables).
# .env is gitignored; this example file holds placeholders only.

# --- Supabase (server only) --------------------------------------------------
# The project URL. The browser never needs this: the API answers /api/state.
SUPABASE_URL=https://<project-ref>.supabase.co

# The server side key (sb_secret_...). Never ship it to the browser, never put
# it in index.html or any client bundle.
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy spelling still read when SUPABASE_SECRET_KEY is unset:
# SUPABASE_SERVICE_ROLE_KEY=

# The publishable key (sb_publishable_...), handed to the browser for the
# realtime doorbell config and for direct file uploads to the "assignments"
# Storage bucket (bucket created by supabase/schema.sql). Public by design;
# row level security and the bucket's size/MIME allow-list keep it from
# reading or writing any table or file it should not.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy spelling still read when the above is unset:
# SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------------
# Set to 1 only when running over plain http (the local harness). Vercel is
# always https and leaves this unset so cookies are Secure.
# FORCE_SECURE_COOKIE=1
